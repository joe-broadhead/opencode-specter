{
  "name": "@joe-broadhead/opencode-specter",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial OpenCode plugin for Specter",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "specter"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-specter#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-specter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-specter.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "conformance": "node scripts/check.mjs conformance",
    "test:kit": "node scripts/check.mjs kit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check.mjs forbidden copies",
    "icons": "node scripts/check.mjs icons",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "specter",
      "name": "Specter",
      "domain": "tryspecter.com"
    }
  },
  "jelly": {
    "title": "Specter",
    "summary": "Specter deal data: companies, their profiles and signals.",
    "icon": "assets/icon.svg",
    "cost": "Specter bills in credits from the team's plan, and does not publish prices: the plugin states about $0.10 a credit as an estimate, and your team's contract rate replaces it. get_company, saved_search_results and the saved-search source each spend one credit per company; the key check is free.",
    "tools": [
      {
        "name": "specter.search_companies",
        "permission": "specter_search_companies",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "specter.get_company",
        "permission": "specter_get_company",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "specter.list_saved_searches",
        "permission": "specter_list_saved_searches",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "specter.saved_search_results",
        "permission": "specter_saved_search_results",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "specter.events_list",
        "permission": "specter_events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "specter.probe",
        "permission": "specter_probe",
        "effect": "allow",
        "readOnly": true
      }
    ],
    "skills": [
      "specter",
      "specter-write"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "account",
        "label": "Specter account",
        "server": "specter"
      },
      {
        "id": "specter",
        "label": "Specter team API key",
        "integration": "specter",
        "required": false,
        "help": {
          "url": "https://app.tryspecter.com/settings/api-console",
          "label": "Copy the team API key from Specter's API Console"
        },
        "needed": [
          "AUTH_REQUIRED",
          "KEY_REJECTED"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow; calls that spend Specter credits count as changes.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        },
        {
          "key": "requestTimeoutMs",
          "label": "Request time limit",
          "type": "number",
          "integer": true,
          "min": 5000,
          "max": 120000,
          "default": 30000,
          "description": "How long one request to Specter's REST API can take, in milliseconds: 5 seconds to 2 minutes. The default is 30 seconds."
        }
      ]
    }
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "specter.deals.tools",
    "probe": {
      "action": "specter_probe"
    },
    "items": [
      {
        "id": "specter.saved",
        "kind": "events",
        "reads": "x-specter/company",
        "tool": "events_list",
        "input": {
          "source": "saved"
        },
        "accounts": {
          "named": false
        },
        "scope": {
          "keys": [
            "search"
          ],
          "describe": "The saved company search to read, by the id the free saved-search list shows.",
          "suggest": {
            "tool": "list_saved_searches",
            "operations": [
              "searches.list"
            ]
          }
        },
        "permission": {
          "events": "specter_events_list",
          "operations": [
            "searches.companies.results"
          ]
        },
        "private": true,
        "cost": {
          "class": "metered",
          "units": [
            {
              "per": "company",
              "usd": 0.1
            }
          ]
        },
        "maxBytes": 65536
      }
    ]
  }
}
